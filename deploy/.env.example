# Apartment Scout — environment variables.
#
# Copy to the PROJECT ROOT as `.env` on the VPS (pipeline/bot/notifier load it
# from there via python-dotenv). `.env` is gitignored — never commit real
# secrets. Fill in the values from your Telegram, Anthropic, and Meta accounts.

# Telegram bot token from @BotFather (required — pipeline + bot).
TELEGRAM_BOT_TOKEN=

# Telegram chat/channel id that receives notifications (required — pipeline).
TELEGRAM_CHAT_ID=

# Anthropic API key for Claude outreach drafts (required for the bot's Save flow;
# note the non-standard variable name used by src/contacter.py).
anthropicAPI=

# Instagram Graph API long-lived token (optional — Instagram scraper only).
INSTAGRAM_TOKEN=

# Your own Instagram Business user id for Business Discovery (optional).
INSTAGRAM_IG_USER_ID=

# Minutes the bot polls before exiting when launched by cron (optional;
# run-bot.sh defaults to 60). Leave unset / 0 for an indefinite persistent bot.
# BOT_RUN_MINUTES=60
